# Copiar como archivo local fuera de Git, por ejemplo:
# qa/config/asistencia-inventario.docker.env
#
# Este archivo es solo para desarrollo e integracion con Docker Linux.
# No usarlo como configuracion de Windows Server ni de produccion.

ASISTENCIA_DB_NAME=infounsa_asistencia_ci
ASISTENCIA_DB_USER=infounsa
ASISTENCIA_DB_PASSWORD=CAMBIAR_PASSWORD_ASISTENCIA
ASISTENCIA_DB_ROOT_PASSWORD=CAMBIAR_PASSWORD_ROOT_ASISTENCIA
ASISTENCIA_QA_DB_PORT=13306
ASISTENCIA_API_PORT=43000
ASISTENCIA_DATABASE_URL=mysql://infounsa:CAMBIAR_PASSWORD_ASISTENCIA@asistencia-db:3306/infounsa_asistencia_ci
ASISTENCIA_ALLOWED_ORIGINS=http://localhost:43000

INVENTARIO_DB_NAME=infounsa_inventario_ci
INVENTARIO_DB_USER=infounsa
INVENTARIO_DB_PASSWORD=CAMBIAR_PASSWORD_INVENTARIO
INVENTARIO_DB_ROOT_PASSWORD=CAMBIAR_PASSWORD_ROOT_INVENTARIO
INVENTARIO_QA_DB_PORT=13307
INVENTARIO_API_PORT=43001
INVENTARIO_DATABASE_URL=mysql://infounsa:CAMBIAR_PASSWORD_INVENTARIO@inventario-db:3306/infounsa_inventario_ci
INVENTARIO_ALLOWED_ORIGINS=http://localhost:43001

JWT_SECRET=CAMBIAR_SECRETO_ASISTENCIA
JWT_SECRET_INVENTARIO=CAMBIAR_SECRETO_INVENTARIO
SEED_ADMIN_PASSWORD=CAMBIAR_PASSWORD_ADMIN

ASISTENCIA_DB_CONNECTION_LIMIT=10
INVENTARIO_DB_CONNECTION_LIMIT=10
ASISTENCIA_DB_CONNECT_TIMEOUT_MS=5000
INVENTARIO_DB_CONNECT_TIMEOUT_MS=5000
ASISTENCIA_DB_ACQUIRE_TIMEOUT_MS=5000
INVENTARIO_DB_ACQUIRE_TIMEOUT_MS=5000
ASISTENCIA_DB_IDLE_TIMEOUT_MS=60000
INVENTARIO_DB_IDLE_TIMEOUT_MS=60000
