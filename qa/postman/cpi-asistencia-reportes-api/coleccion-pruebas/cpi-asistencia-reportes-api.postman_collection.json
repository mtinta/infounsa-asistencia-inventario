  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === 'Precondicion - API asistencia saludable' || !pm.environment.get('reportRunId')) {",
          "  const runId = Date.now().toString();",
          "  const base = new Date(Date.now() + 30 * 86400000);",
          "  const atMinutes = (minutes) => new Date(base.getTime() + minutes * 60000).toISOString();",
          "  pm.environment.set('reportRunId', runId);",
          "  pm.environment.set('reportEntryOperation', `report-entry-${runId}`);",
          "  pm.environment.set('reportExitOperation', `report-exit-${runId}`);",
          "  pm.environment.set('reportFilterOperation', `report-filter-${runId}`);",
          "  pm.environment.set('reportEditOperation', `report-edit-${runId}`);",
          "  pm.environment.set('reportDeleteOperation', `report-delete-${runId}`);",
          "  pm.environment.set('reportMinorOperation', `report-minor-${runId}`);",
          "  pm.environment.set('reportVisitorOperation', `report-visitor-${runId}`);",
          "  pm.environment.set('reportEntryDate', atMinutes(0));",
          "  pm.environment.set('reportExitDate', atMinutes(5));",
          "  pm.environment.set('reportFilterDate', atMinutes(10));",
          "  pm.environment.set('reportEditDate', atMinutes(15));",
          "  pm.environment.set('reportDeleteDate', atMinutes(20));",
          "  pm.environment.set('reportMinorDate', atMinutes(25));",
          "  pm.environment.set('reportVisitorDate', atMinutes(30));",
          "  pm.environment.set('reportManualDate', atMinutes(35));",
          "  pm.environment.set('reportStartDate', new Date(base.getTime() - 3600000).toISOString());",
          "  pm.environment.set('reportEndDate', new Date(base.getTime() + 86400000).toISOString());",
          "  let seededDay = base.getDay();",
          "  if (seededDay === 0) seededDay = 7;",
          "  pm.environment.set('excludedDayOfWeek', String((seededDay % 7) + 1));",
          "  const now = new Date();",
          "  pm.environment.set('exact90StartDate', new Date(now.getTime() - 90 * 86400000).toISOString());",
          "  pm.environment.set('exact90EndDate', now.toISOString());",
          "  pm.environment.set('longStartDate', new Date(now.getTime() - 91 * 86400000).toISOString());",
          "  pm.environment.set('longEndDate', now.toISOString());",
          "  pm.environment.set('invertedStartDate', new Date(now.getTime() + 86400000).toISOString());",
          "  pm.environment.set('invertedEndDate', now.toISOString());",
          "}"
        ]
      }
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{adminAccessToken}}",
        "type": "string"
      }
    ]
  }
