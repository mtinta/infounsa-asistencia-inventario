              "const json = pm.response.json();",
              "pm.test('Marca manual auditada como nueva', () => { pm.expect(json.id_operacion_local).to.match(/^manual-/); pm.expect(json.estado_auditoria).to.eql('nuevo'); });",
              "pm.environment.set('manualAttendanceId', json.id);",
              "pm.environment.set('manualOperationId', json.id_operacion_local);"
            ]
          }
