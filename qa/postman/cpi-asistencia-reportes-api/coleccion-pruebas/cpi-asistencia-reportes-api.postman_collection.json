    {
      "name": "Setup - Crear marcas controladas",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/attendance/sync",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"terminal_id\": \"{{terminalId}}\",\n  \"sede_id\": \"{{sedeId}}\",\n  \"registros\": [\n    {\n      \"id_operacion_local\": \"{{reportEntryOperation}}\",\n      \"usuario_id\": \"USR-001\",\n      \"fecha_hora_marca\": \"{{reportEntryDate}}\",\n      \"tipo\": \"entrada\",\n      \"es_menor_manual\": false\n    },\n    {\n      \"id_operacion_local\": \"{{reportExitOperation}}\",\n      \"usuario_id\": \"USR-001\",\n      \"fecha_hora_marca\": \"{{reportExitDate}}\",\n      \"tipo\": \"salida\",\n      \"es_menor_manual\": false\n    },\n    {\n      \"id_operacion_local\": \"{{reportFilterOperation}}\",\n      \"usuario_id\": \"USR-002\",\n      \"fecha_hora_marca\": \"{{reportFilterDate}}\",\n      \"tipo\": \"entrada\",\n      \"es_menor_manual\": false\n    },\n    {\n      \"id_operacion_local\": \"{{reportEditOperation}}\",\n      \"usuario_id\": \"USR-004\",\n      \"fecha_hora_marca\": \"{{reportEditDate}}\",\n      \"tipo\": \"entrada\",\n      \"es_menor_manual\": false\n    },\n    {\n      \"id_operacion_local\": \"{{reportDeleteOperation}}\",\n      \"usuario_id\": \"USR-003\",\n      \"fecha_hora_marca\": \"{{reportDeleteDate}}\",\n      \"tipo\": \"entrada\",\n      \"es_menor_manual\": false\n    },\n    {\n      \"id_operacion_local\": \"{{reportMinorOperation}}\",\n      \"usuario_id\": null,\n      \"fecha_hora_marca\": \"{{reportMinorDate}}\",\n      \"tipo\": \"entrada\",\n      \"es_menor_manual\": true,\n      \"datos_menor\": { \"nombre_completo\": \"Menor QA\" }\n    },\n    {\n      \"id_operacion_local\": \"{{reportVisitorOperation}}\",\n      \"usuario_id\": null,\n      \"fecha_hora_marca\": \"{{reportVisitorDate}}\",\n      \"tipo\": \"entrada\",\n      \"es_menor_manual\": false,\n      \"visitante_nombre\": \"Visitante Reportes QA\",\n      \"visitante_motivo\": \"Auditoria\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Inserta siete marcas', () => { pm.expect(json.stats.recibidos).to.eql(7); pm.expect(json.stats.insertados).to.eql(7); });"
            ]
          }
        }
      ],
      "response": [],
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{adminAccessToken}}",
            "type": "string"
          }
        ]
      }
    },
