    {
      "name": "CPI-AST-ATT-08 Reporte JSON por rango",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/attendance/report?startDate={{reportStartDate}}&endDate={{reportEndDate}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Retorna resumen por usuario', () => pm.expect(json).to.be.an('array').that.is.not.empty);",
              "pm.test('Contabiliza entrada y salida de USR-001', () => { const row = json.find((item) => item.user_id === 'USR-001'); pm.expect(row).to.exist; pm.expect(row.total_entradas).to.eql(1); pm.expect(row.total_salidas).to.eql(1); });",
              "pm.test('Excluye marca borrada de USR-003', () => pm.expect(json.some((item) => item.user_id === 'USR-003')).to.eql(false));"
            ]
          }
        }
      ],
      "response": [],
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{adminAccessToken}}",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "CPI-AST-ATT-13 Consultar estadisticas",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/attendance/stats?startDate={{reportStartDate}}&endDate={{reportEndDate}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Total excluye borrados', () => pm.expect(json.total_marcas).to.eql(7));",
              "pm.test('Cuenta seis usuarios unicos', () => pm.expect(json.usuarios_con_marcas).to.eql(6));",
              "pm.test('Agrupa entrada y salida', () => { const map = Object.fromEntries(json.por_tipo.map((row) => [row.tipo, row.total])); pm.expect(map.entrada).to.eql(5); pm.expect(map.salida).to.eql(2); });"
            ]
          }
        }
      ],
      "response": [],
      "auth": {
        "type": "bearer",
        "bearer": [
