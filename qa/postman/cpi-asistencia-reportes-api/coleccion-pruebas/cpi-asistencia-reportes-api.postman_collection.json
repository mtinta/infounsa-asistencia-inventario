{
  "info": {
    "_postman_id": "214dd2f3-b64d-4429-a46e-aa7877b7774b",
    "name": "CPI Asistencia - Reportes y Auditoria",
    "description": "Implementacion Postman/Newman de reportes y auditoria. CPI-AST-AUD-04 valida la exportacion administrativa y CPI-AST-RPT-05 centraliza todos los controles de autorizacion de reportes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Precondicion - API asistencia saludable",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('MySQL/MariaDB conectada', () => { pm.expect(json.status).to.eql('ok'); pm.expect(json.database).to.eql('connected'); });",
              "pm.test('Identifica asistencia-api', () => pm.expect(json.service).to.eql('asistencia-api'));"
            ]
          }
        }
      ],
      "response": [],
      "auth": {
        "type": "noauth"
      }
    },
    {
      "name": "Setup - Login administrador",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Rol administrador', () => pm.expect(json.user.role).to.eql('administrador'));",
              "pm.environment.set('adminAccessToken', json.access_token);"
