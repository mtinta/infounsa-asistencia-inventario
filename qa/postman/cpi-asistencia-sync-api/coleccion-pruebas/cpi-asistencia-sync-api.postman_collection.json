    {
      "name": "CPI-AST-ATT-01 Registrar marca directa valida",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/attendance/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario_id\": \"{{attendanceUserId}}\",\n  \"terminal_id\": \"{{terminalId}}\",\n  \"sede_id\": \"{{sedeId}}\",\n  \"fecha_hora_marca\": \"{{markTimestamp}}\",\n  \"id_operacion_local\": \"{{directOperation}}\",\n  \"tipo\": \"entrada\",\n  \"observacion\": \"Registro directo QA\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test('Persiste referencias y operacion', () => { pm.expect(json.id_operacion_local).to.eql(pm.environment.get('directOperation')); pm.expect(json.usuario_id).to.eql(pm.environment.get('attendanceUserId')); });",
              "pm.test('No es duplicado inicial', () => pm.expect(json.duplicated).not.to.eql(true));"
            ]
          }
        }
      ],
      "response": [],
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{operatorAccessToken}}",
            "type": "string"
          }
        ]
      }
    },
