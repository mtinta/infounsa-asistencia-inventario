    {
      "name": "CPI-AST-SYNC-22 Sincronizar entrada y salida",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/attendance/sync",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"terminal_id\": \"{{terminalId}}\",\n  \"sede_id\": \"{{sedeId}}\",\n  \"registros\": [\n    {\n      \"id_operacion_local\": \"{{syncTypeEntryOperation}}\",\n      \"usuario_id\": \"{{attendanceUserId}}\",\n      \"fecha_hora_marca\": \"{{markTimestamp}}\",\n      \"tipo\": \"entrada\",\n      \"es_menor_manual\": false\n    },\n    {\n      \"id_operacion_local\": \"{{syncTypeExitOperation}}\",\n      \"usuario_id\": \"{{attendanceUserId}}\",\n      \"fecha_hora_marca\": \"{{markTimestamp}}\",\n      \"tipo\": \"salida\",\n      \"es_menor_manual\": false\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Procesa entrada y salida nuevas', () => { pm.expect(json.success).to.eql(true); pm.expect(json.stats).to.deep.include({ recibidos: 2, insertados: 2, omitidosPorDuplicado: 0 }); });",
              "pm.test('Retorna ambos IDs', () => { pm.expect(json.processed_local_ids).to.include(pm.environment.get('syncTypeEntryOperation')); pm.expect(json.processed_local_ids).to.include(pm.environment.get('syncTypeExitOperation')); });"
            ]
          }
        }
      ],
      "response": [],
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{operatorAccessToken}}",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "CPI-AST-SYNC-07 Reenviar y actualizar duplicado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
