{
  "info": {
    "_postman_id": "8f1779cb-1d2b-4c7a-8640-fb26d187d479",
    "name": "CPI Asistencia - Marcaciones y Sincronizacion",
    "description": "Implementacion Postman/Newman de marcaciones y sincronizacion. La matriz CPI-AST-SYNC-20 centraliza autorizacion; CPI-AST-SYNC-01 y CPI-AST-SYNC-22 usan datos independientes para evitar fallos encadenados.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Precondicion - API asistencia saludable",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('MySQL/MariaDB conectada', () => { pm.expect(json.status).to.eql('ok'); pm.expect(json.database).to.eql('connected'); });",
              "pm.test('Identifica asistencia-api', () => pm.expect(json.service).to.eql('asistencia-api'));"
            ]
          }
        }
      ],
      "response": [],
      "auth": {
        "type": "noauth"
      }
    },
    {
      "name": "Setup - Login operador semilla",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{operatorUsername}}\",\n  \"password\": \"{{operatorPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Rol operador', () => pm.expect(json.user.role).to.eql('operador'));",
              "pm.environment.set('operatorAccessToken', json.access_token);"
            ]
          }
        }
      ],
      "response": [],
      "auth": {
        "type": "noauth"
      }
    },
