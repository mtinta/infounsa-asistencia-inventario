          "raw": "{\n  \"terminal_id\": \"{{terminalId}}\",\n  \"sede_id\": \"{{sedeId}}\",\n  \"registros\": [{\n    \"id_operacion_local\": \"{{syncEntryOperation}}\",\n    \"usuario_id\": \"{{attendanceUserId}}\",\n    \"fecha_hora_marca\": \"{{markTimestamp}}\",\n    \"tipo\": \"salida\",\n    \"es_menor_manual\": false,\n    \"observacion\": \"Reintento actualizado\"\n  }]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('No inserta segunda fila', () => { pm.expect(json.stats.insertados).to.eql(0); pm.expect(json.stats.omitidosPorDuplicado).to.eql(1); });",
              "pm.test('Reporta ID procesado', () => pm.expect(json.processed_local_ids).to.include(pm.environment.get('syncEntryOperation')));"
            ]
          }
        }
      ],
