    {
      "name": "CPI-AST-SYNC-01 Sincronizar registro valido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/attendance/sync",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"terminal_id\": \"{{terminalId}}\",\n  \"sede_id\": \"{{sedeId}}\",\n  \"registros\": [{\n    \"id_operacion_local\": \"{{syncEntryOperation}}\",\n    \"usuario_id\": \"{{attendanceUserId}}\",\n    \"fecha_hora_marca\": \"{{markTimestamp}}\",\n    \"tipo\": \"entrada\",\n    \"es_menor_manual\": false\n  }]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Procesa una marca nueva', () => { pm.expect(json.success).to.eql(true); pm.expect(json.stats).to.deep.include({ recibidos: 1, insertados: 1, omitidosPorDuplicado: 0 }); });",
              "pm.test('Retorna ID procesado', () => pm.expect(json.processed_local_ids).to.include(pm.environment.get('syncEntryOperation')));"
            ]
          }
        }
      ],
      "response": [],
      "auth": {
        "type": "bearer",
        "bearer": [
