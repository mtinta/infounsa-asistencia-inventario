        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Retorna token operador', () => pm.expect(json.user.role).to.eql('operador'));",
              "pm.environment.set('operatorAccessToken', json.access_token);"
            ]
          }
        }
      ],
      "response": [],
      "auth": {
        "type": "noauth"
      }
    },
