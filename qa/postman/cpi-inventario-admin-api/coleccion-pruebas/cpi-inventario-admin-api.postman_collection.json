{
  "info": {
    "_postman_id": "20f01345-4412-4a35-950f-5b82e128c28e",
    "name": "CPI Inventario - API de Areas, Usuarios y Permisos",
    "description": "Implementacion Postman/Newman de cpi-inventario-admin-api.md. Cubre areas, usuarios, validacion de datos, seguridad de contrasenas y autorizacion por roles.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{adminAccessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === 'Precondicion - API inventario saludable' || !pm.environment.get('adminRunId')) {",
          "  const runId = Date.now().toString();",
          "  pm.environment.set('adminRunId', runId);",
          "  pm.environment.set('operatorUsername', `qa_admin_operator_${runId}`);",
          "  pm.environment.set('operatorEmail', `qa_admin_operator_${runId}@example.test`);",
          "  pm.environment.set('operatorPassword', 'QaAdminOperator123*');",
          "  pm.environment.set('operatorFullName', `QA Admin Operator ${runId}`);",
          "  pm.environment.set('areaName', `QA Area Admin ${runId}`);",
          "  pm.environment.set('areaNameUpdated', `QA Area Admin Actualizada ${runId}`);",
          "  pm.environment.set('areaResponsible', `Responsable QA ${runId}`);",
          "  pm.environment.set('areaResponsibleUpdated', `Responsable QA Actualizado ${runId}`);",
          "  pm.environment.set('blockedAreaName', `QA Area Bloqueada ${runId}`);",
          "  pm.environment.set('unknownAreaName', `QA Area Campo Extra ${runId}`);",
          "  pm.environment.set('userUsername', `qa_admin_user_${runId}`);",
          "  pm.environment.set('userEmail', `qa_admin_user_${runId}@example.test`);",
          "  pm.environment.set('userPassword', 'QaAdminUser123*');",
          "  pm.environment.set('userNewPassword', 'QaAdminUser456*');",
          "  pm.environment.set('userFullName', `QA Usuario Admin ${runId}`);",
          "  pm.environment.set('userFullNameUpdated', `QA Usuario Admin Actualizado ${runId}`);",
          "  pm.environment.set('alternateUsername', `qa_admin_alt_${runId}`);",
          "  pm.environment.set('alternateEmail', `qa_admin_alt_${runId}@example.test`);",
          "  pm.environment.set('missingPasswordUsername', `qa_admin_no_pass_${runId}`);",
          "  pm.environment.set('missingPasswordEmail', `qa_admin_no_pass_${runId}@example.test`);",
          "  pm.environment.set('extraFieldUsername', `qa_admin_extra_${runId}`);",
          "  pm.environment.set('extraFieldEmail', `qa_admin_extra_${runId}@example.test`);",
          "  pm.environment.set('missingEntityId', '2147483647');",
          "  pm.environment.set('invalidAreaId', '0');",
          "  pm.environment.set('missingPasswordUserId', '0');",
          "  pm.environment.set('extraFieldUserId', '0');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Precondicion - API inventario saludable",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('MySQL/MariaDB conectada', () => { pm.expect(json.status).to.eql('ok'); pm.expect(json.database).to.eql('connected'); });",
              "pm.test('Identifica inventario-api', () => pm.expect(json.service).to.eql('inventario-api'));"
            ]
          }
        }
      ],
      "response": [],
      "auth": {
        "type": "noauth"
      }
    },
    {
      "name": "Setup - Registrar operador QA",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"{{operatorFullName}}\",\n  \"email\": \"{{operatorEmail}}\",\n  \"username\": \"{{operatorUsername}}\",\n  \"password\": \"{{operatorPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test('Crea operador', () => pm.expect(json.user.role).to.eql('operador'));",
              "pm.environment.set('operatorUserId', String(json.user.id));"
            ]
          }
        }
      ],
      "response": [],
      "auth": {
        "type": "noauth"
      }
    },
    {
      "name": "Setup - Login operador QA",
