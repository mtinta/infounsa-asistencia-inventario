{
  "info": {
    "_postman_id": "8d0e5508-0575-4da1-8ad6-189cf1d772b1",
    "name": "CPI Inventario - API de Autenticacion",
    "description": "Coleccion Postman/Newman alineada con docs/07_aseguramiento_calidad/casos_de_pruebas/pruebas_de_integracion/cpi-inventario-auth-api.md. Cubre autenticacion, validacion, renovacion JWT y proteccion de endpoints de Inventario.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === 'Precondicion - API inventario saludable' || !pm.environment.get('authRunId')) {",
          "  const runId = Date.now().toString();",
          "  pm.environment.set('authRunId', runId);",
          "  pm.environment.set('testUsername', `qa_inv_auth_${runId}`);",
          "  pm.environment.set('testEmail', `qa_inv_auth_${runId}@example.test`);",
          "  pm.environment.set('alternateUsername', `qa_inv_auth_alt_${runId}`);",
          "  pm.environment.set('testPassword', 'QaInventario123*');",
          "  pm.environment.set('testFullName', `QA Inventario Auth ${runId}`);",
          "}",
          "function encodeBase64Url(wordArray) {",
          "  return CryptoJS.enc.Base64.stringify(wordArray).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
          "}",
          "function qaJwt(payload) {",
          "  const header = encodeBase64Url(CryptoJS.enc.Utf8.parse(JSON.stringify({ alg: 'HS256', typ: 'JWT' })));",
          "  const encodedPayload = encodeBase64Url(CryptoJS.enc.Utf8.parse(JSON.stringify(payload)));",
          "  const unsigned = `${header}.${encodedPayload}`;",
          "  const signature = encodeBase64Url(CryptoJS.HmacSHA256(unsigned, pm.environment.get('jwtSecret')));",
          "  return `${unsigned}.${signature}`;",
          "}",
          "const now = Math.floor(Date.now() / 1000);",
          "pm.environment.set('expiredRefreshToken', qaJwt({ sub: 1, username: 'qa_expired', role: 'operador', subsystem: 'inventario', iat: now - 7200, exp: now - 3600 }));",
          "pm.environment.set('foreignSubsystemToken', qaJwt({ sub: 1, username: 'qa_foreign', role: 'operador', subsystem: 'asistencia', iat: now, exp: now + 3600 }));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:43001",
      "type": "string"
    }
