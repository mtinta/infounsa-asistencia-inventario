    {
      "name": "CPI-INV-AUTH-17.1 Validar claims y vigencia del JWT",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{accessToken}}",
            "type": "string"
          }
        ]
      },
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/inventory-items?page=1&limit=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const token = pm.environment.get('accessToken');",
              "const encodedPayload = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
              "const paddedPayload = encodedPayload.padEnd(Math.ceil(encodedPayload.length / 4) * 4, '=');",
              "const payload = JSON.parse(decodeURIComponent(escape(atob(paddedPayload))));",
              "pm.test('Claims obligatorios presentes', () => { ['sub', 'username', 'role', 'subsystem', 'iat', 'exp'].forEach((claim) => pm.expect(payload).to.have.property(claim)); });",
              "pm.test('Claims coherentes y vigentes', () => { pm.expect(payload.username).to.eql(pm.environment.get('testUsername')); pm.expect(payload.role).to.eql('operador'); pm.expect(payload.subsystem).to.eql('inventario'); pm.expect(payload.exp).to.be.above(payload.iat); pm.expect(payload.exp).to.be.above(Math.floor(Date.now() / 1000)); });"
            ]
          }
        }
      ],
      "response": []
    },
