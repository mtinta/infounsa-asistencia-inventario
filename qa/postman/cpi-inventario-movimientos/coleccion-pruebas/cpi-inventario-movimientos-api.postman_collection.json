{
  "info": {
    "_postman_id": "efcf4855-b92f-4fb0-bbdd-e5d9c0fbfc3d",
    "name": "CPI Inventario - API de Movimientos y Sincronizacion",
    "description": "Implementacion Postman/Newman de cpi-inventario-movimientos-api.md. Cubre movimientos principales, stock, sincronizacion, idempotencia, validaciones, concurrencia, historial y autorizacion de reportes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{operatorAccessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === 'Precondicion - API inventario saludable' || !pm.environment.get('movementRunId')) {",
          "  const runId = Date.now().toString();",
          "  const guid = () => pm.variables.replaceIn('{{$guid}}');",
          "  pm.environment.set('movementRunId', runId);",
          "  pm.environment.set('operatorUsername', `qa_mov_${runId}`);",
          "  pm.environment.set('operatorEmail', `qa_mov_${runId}@example.test`);",
          "  pm.environment.set('operatorPassword', 'QaMovimientos123*');",
          "  pm.environment.set('operatorFullName', `QA Movimientos ${runId}`);",
          "  pm.environment.set('categoryName', `QA Categoria Movimientos ${runId}`);",
          "  pm.environment.set('itemBarcode', `QA-MOV-${runId}`);",
          "  pm.environment.set('itemName', `Bien QA Movimientos ${runId}`);",
          "  ['opEntrada','opEntradaCero','opSalida','opSalidaInsuficiente','opMissingItem','opMissingUser','opMissingArea','opTypeInvalid','opDateInvalid','opNegative','opExtraField','syncOpEntrada','syncOpSalida','syncAtomicFirst','syncAtomicSecond','concurrentOpOne','concurrentOpTwo'].forEach((key) => pm.environment.set(key, guid()));",
          "  pm.environment.set('missingEntityId', '2147483647');",
          "}",
          "const now = new Date();",
          "const isoDaysFromNow = (days) => new Date(now.getTime() + days * 86400000).toISOString();",
          "pm.environment.set('registeredAt', now.toISOString());",
          "pm.environment.set('reportStartDate', isoDaysFromNow(-1));",
          "pm.environment.set('reportEndDate', isoDaysFromNow(1));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Precondicion - API inventario saludable",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('MySQL/MariaDB conectada', () => { pm.expect(json.status).to.eql('ok'); pm.expect(json.database).to.eql('connected'); });",
              "pm.test('Identifica inventario-api', () => pm.expect(json.service).to.eql('inventario-api'));"
            ]
          }
        }
      ],
      "response": [],
      "auth": {
        "type": "noauth"
      }
    },
