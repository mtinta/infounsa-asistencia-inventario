    {
      "name": "CPI-INV-MOV-23.1 Ejecutar salidas concurrentes",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const url = `${pm.environment.get('baseUrl')}/inventory-movements`;",
              "const token = pm.environment.get('operatorAccessToken');",
              "const makeBody = (operationId) => ({ item_id: Number(pm.environment.get('itemId')), type: 'salida', quantity: 1, user_id: Number(pm.environment.get('operatorUserId')), registered_at: new Date().toISOString(), id_operacion_local: operationId });",
              "const responses = [];",
              "const collect = (error, response) => {",
              "  pm.expect(error).to.eql(null);",
              "  responses.push(response.code);",
              "  if (responses.length === 2) pm.test('Una salida se acepta y otra se rechaza', () => pm.expect(responses.sort()).to.eql([201, 400]));",
              "};",
              "pm.sendRequest({ url, method: 'POST', header: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }, body: { mode: 'raw', raw: JSON.stringify(makeBody(pm.environment.get('concurrentOpOne'))) } }, collect);",
              "pm.sendRequest({ url, method: 'POST', header: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }, body: { mode: 'raw', raw: JSON.stringify(makeBody(pm.environment.get('concurrentOpTwo'))) } }, collect);"
            ]
          }
        }
      ],
      "response": [],
      "auth": {
        "type": "noauth"
      }
    },
