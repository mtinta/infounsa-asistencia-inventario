{
  "info": {
    "_postman_id": "7ee6fe66-7b92-4a06-bd05-980548726b41",
    "name": "CPI Inventario - API de Catalogo",
    "description": "Implementacion Postman/Newman de cpi-inventario-catalogo-api.md. Cubre categorias, bienes, barcode automatico, relaciones, paginacion, validaciones y seguridad JWT contra la API actual de Inventario.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{adminAccessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === 'Precondicion - API inventario saludable' || !pm.environment.get('catalogRunId')) {",
          "  const runId = Date.now().toString();",
          "  pm.environment.set('catalogRunId', runId);",
          "  pm.environment.set('categoryName', `QA Categoria Catalogo ${runId}`);",
          "  pm.environment.set('categoryDescription', `Categoria creada por CPI catalogo ${runId}`);",
          "  pm.environment.set('categoryDescriptionUpdated', `Categoria actualizada por CPI catalogo ${runId}`);",
          "  pm.environment.set('itemBarcode', `QA-CAT-${runId}`);",
          "  pm.environment.set('secondItemBarcode', `QA-CAT-SECOND-${runId}`);",
          "  pm.environment.set('missingBarcode', `QA-CAT-MISSING-${runId}`);",
          "  pm.environment.set('negativeBarcode', `QA-CAT-NEG-${runId}`);",
          "  pm.environment.set('missingNameBarcode', `QA-CAT-SIN-NOMBRE-${runId}`);",
          "  pm.environment.set('itemName', `Bien QA Catalogo ${runId}`);",
          "  pm.environment.set('missingItemId', '2147483647');",
          "  pm.environment.set('invalidMissingNameItemId', '0');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Precondicion - API inventario saludable",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('MySQL/MariaDB conectada', () => { pm.expect(json.status).to.eql('ok'); pm.expect(json.database).to.eql('connected'); });",
              "pm.test('Identifica inventario-api', () => pm.expect(json.service).to.eql('inventario-api'));"
            ]
          }
        }
      ],
      "response": [],
      "auth": {
        "type": "noauth"
      }
    },
    {
      "name": "Setup - Login administrador para catalogo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Login de administrador', () => pm.expect(json.user.role).to.eql('administrador'));",
              "pm.environment.set('adminAccessToken', json.access_token);"
            ]
          }
        }
      ],
      "response": [],
      "auth": {
        "type": "noauth"
      }
    },
