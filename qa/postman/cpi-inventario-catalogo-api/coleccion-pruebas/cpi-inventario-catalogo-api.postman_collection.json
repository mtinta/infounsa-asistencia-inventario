        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test('Retorna categoria creada', () => { pm.expect(json.id).to.exist; pm.expect(json.name).to.eql(pm.environment.get('categoryName')); });",
              "pm.environment.set('categoryId', String(json.id));"
            ]
          }
        }
      ],
      "response": []
