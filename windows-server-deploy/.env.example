# Copiar fuera del repositorio, por ejemplo:
# C:\ProgramData\InfoUNSA\config\infounsa-production.env
# Sustituir todos los valores de ejemplo antes de registrar la tarea de inicio.

ASISTENCIA_DATABASE_URL=mysql://infounsa_asistencia_app:CAMBIAR_PASSWORD@host.docker.internal:3306/infounsa_asistencia
INVENTARIO_DATABASE_URL=mysql://infounsa_inventario_app:CAMBIAR_PASSWORD@host.docker.internal:3306/infounsa_inventario
JWT_SECRET=CAMBIAR_SECRETO_ALEATORIO_ASISTENCIA
JWT_SECRET_INVENTARIO=CAMBIAR_SECRETO_ALEATORIO_INVENTARIO

# Produccion: TLS es obligatorio y la validacion del certificado no se puede desactivar.
ASISTENCIA_MYSQL_SSL=true
ASISTENCIA_MYSQL_SSL_REJECT_UNAUTHORIZED=true
INVENTARIO_MYSQL_SSL=true
INVENTARIO_MYSQL_SSL_REJECT_UNAUTHORIZED=true

# Carpeta del host que contiene mysql-ca.pem; no incluir la CA ni el archivo real en Git.
INFOUNSA_MYSQL_CA_DIR=C:\ProgramData\InfoUNSA\secrets\mysql

# Pool por API. El total inicial es 20 conexiones; ajustar segun max_connections y carga.
ASISTENCIA_DB_CONNECTION_LIMIT=10
INVENTARIO_DB_CONNECTION_LIMIT=10
ASISTENCIA_DB_CONNECT_TIMEOUT_MS=5000
INVENTARIO_DB_CONNECT_TIMEOUT_MS=5000
ASISTENCIA_DB_ACQUIRE_TIMEOUT_MS=5000
INVENTARIO_DB_ACQUIRE_TIMEOUT_MS=5000
ASISTENCIA_DB_IDLE_TIMEOUT_MS=60000
INVENTARIO_DB_IDLE_TIMEOUT_MS=60000
