# Copia este archivo como ".env" (copy .env.example .env) y cambia los valores marcados con CAMBIAR.
# Escribe cada variable en una linea, sin espacios alrededor del "=" ni comillas.
PORT=43000
NODE_ENV=development
# Usuario y contrasena de MySQL creados en el manual (paso b) y nombre de la base
DATABASE_URL=mysql://infounsa:CAMBIAR_PASSWORD@localhost:3306/infounsa_asistencia
# Cadena larga y aleatoria (ver el manual, paso c, para generarla)
JWT_SECRET=CAMBIAR_POR_UNA_CADENA_LARGA_Y_ALEATORIA
# Origenes (apps web) autorizados a consumir la API, separados por comas
ASISTENCIA_ALLOWED_ORIGINS=http://localhost:43000,http://127.0.0.1:43000
# Opcional: contrasena inicial de los usuarios que crea el seed (minimo 8 caracteres). Por defecto: admin123
# SEED_ADMIN_PASSWORD=
