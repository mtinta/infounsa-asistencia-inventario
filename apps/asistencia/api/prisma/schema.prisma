datasource db {
  provider = "mysql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

model Role {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(50)
  description String?   @db.VarChar(255)
  usuarios    Usuario[]

  @@map("roles")
}

model Sede {
  id          String       @id @default(uuid()) @db.VarChar(50)
  nombre      String       @db.VarChar(100)
  name        String?      @db.VarChar(100)
  code        String?      @unique @db.VarChar(50)
  direccion   String?      @db.VarChar(255)
  address     String?      @db.VarChar(255)
  estado      Boolean      @default(true)
  created_at  DateTime     @default(now()) @db.DateTime(3)
  updated_at  DateTime     @default(now()) @updatedAt @db.DateTime(3)
  usuarios    Usuario[]
  terminales  Terminal[]
  asistencias Asistencia[]

  @@map("sedes")
}

model Terminal {
  id          String       @id @db.VarChar(50)
  nombre      String       @default("") @db.VarChar(100)
  name        String?      @db.VarChar(100)
  code        String?      @unique @db.VarChar(50)
  sede_id     String?      @db.VarChar(50)
  estado      Boolean      @default(true)
  status      String       @default("activo") @db.VarChar(30)
  created_at  DateTime     @default(now()) @db.DateTime(3)
  updated_at  DateTime     @default(now()) @updatedAt @db.DateTime(3)
  sede        Sede?        @relation(fields: [sede_id], references: [id])
  asistencias Asistencia[]

  @@map("terminals")
}

model Usuario {
  id               String       @id @default(uuid()) @db.VarChar(50)
  dni              String?      @unique @db.VarChar(20)
  username         String?      @unique @db.VarChar(50)
  email            String?      @unique @db.VarChar(100)
  password         String?      @db.VarChar(255)
  nombres          String       @default("") @db.VarChar(100)
  apellido_paterno String       @default("") @db.VarChar(100)
  apellido_materno String       @default("") @db.VarChar(100)
  nombre_completo  String?      @db.VarChar(255)
  full_name        String?      @db.VarChar(255)
  condicion        String?      @db.VarChar(50)
  cargo            String?      @db.VarChar(100)
  estado           Boolean      @default(true)
  status           String       @default("activo") @db.VarChar(30)
  role_id          Int?
  sede_id          String?      @db.VarChar(50)
  created_at       DateTime     @default(now()) @db.DateTime(3)
  updated_at       DateTime     @default(now()) @updatedAt @db.DateTime(3)
  role             Role?        @relation(fields: [role_id], references: [id])
  sede             Sede?        @relation(fields: [sede_id], references: [id])
  asistencias      Asistencia[]

  @@map("users")
}

model Asistencia {
  id                 String    @id @default(uuid()) @db.VarChar(50)
  id_operacion_local String?   @unique @db.VarChar(150)
  usuario_id         String?   @db.VarChar(50)
  terminal_id        String?   @db.VarChar(50)
  sede_id            String?   @db.VarChar(50)
  tipo               String    @db.VarChar(20)
  fecha_hora_marca   DateTime  @db.DateTime(3)
  creado_en          DateTime  @default(now()) @db.DateTime(3)
  observacion        String?   @db.Text
  sync_status        String    @default("sincronizado") @db.VarChar(30)
  estado_auditoria   String    @default("normal") @db.VarChar(30)
  usuario            Usuario?  @relation(fields: [usuario_id], references: [id])
  terminal           Terminal? @relation(fields: [terminal_id], references: [id])
  sede               Sede?     @relation(fields: [sede_id], references: [id])

  @@index([fecha_hora_marca])
  @@map("attendance")
}

model SyncLog {
  id                Int      @id @default(autoincrement())
  terminal_id       String   @db.VarChar(100)
  sync_at           DateTime @default(now()) @db.DateTime(3)
  status            String   @db.VarChar(30)
  records_processed Int      @default(0)
  error_message     String?  @db.Text

  @@map("sync_logs")
}
